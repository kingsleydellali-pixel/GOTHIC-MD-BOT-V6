# Your WhatsApp session ID from the pairing site
# Get it from: https://your-pairing-site.onrender.com
SESSION_ID=GOTHIC-MD:~

# Bot owner number (with country code, no + sign)
OWNER_NUMBER=233535502036

# Bot owner name
OWNER_NAME=KINGSLEY-XMD

# WhatsApp Channel ID for auto-join (the part after the URL)
# Example: https://whatsapp.com/channel/0029VaghjWRHVvTh35lfZ817
# The ID is: 0029VaghjWRHVvTh35lfZ817
CHANNEL_ID=0029Vb6zdPc5vKAAAY0imG2R

# Custom channel reaction emojis (comma separated)
CHANNEL_REACTIONS=❤️,🔥,💯,⚡,🎯,💀,👑,🚀

# Bot prefix
PREFIX=.

# Port for Render web service
PORT=3000

# Node environment
NODE_ENV=production

# Bot name
BOT_NAME=GOTHIC MD BOT

# Bot image URL (direct image link for menu)
BOT_IMAGE=https://i.ibb.co/zVyCpvQX/ERFAN-MD.jpg

# Auto-join channel on connect (true/false)
AUTO_JOIN_CHANNEL=true

# Auto-react to channel messages (true/false)
AUTO_REACT_CHANNEL=true
